FROM gradle:8.8-jdk17

WORKDIR /workspace

USER root
RUN apt-get update && apt-get install -y \
    chromium \
    chromium-driver \
    && rm -rf /var/lib/apt/lists/*

USER gradle

COPY gradlew .
COPY gradle ./gradle
COPY build.gradle.kts settings.gradle.kts ./
COPY src ./src

RUN chmod +x gradlew

ENV SPRING_PROFILES_ACTIVE=test

CMD ["sh", "-c", "./gradlew --no-daemon runAllTests"]